{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vfcngkfkpwtolginiecm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "paisa-mcp",
      "version": "0.1.0",
      "title": "Paisa"
    },
    "tools": [
      {
        "name": "list_transactions",
        "title": "List transactions",
        "description": "List the signed-in user's income and expense transactions, optionally filtered by date range, type, or category name. Returns most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "description": "Inclusive start date in YYYY-MM-DD.",
              "type": "string"
            },
            "end_date": {
              "description": "Inclusive end date in YYYY-MM-DD.",
              "type": "string"
            },
            "type": {
              "description": "Filter by transaction type.",
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            },
            "category_name": {
              "description": "Case-insensitive category name filter.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum rows to return. Defaults to 50.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "add_transaction",
        "title": "Add transaction",
        "description": "Record a new income or expense for the signed-in user. Resolves the category by name (case-insensitive) among the user's categories of the given type.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Amount in the user's currency."
            },
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ],
              "description": "Whether this is income or an expense."
            },
            "category_name": {
              "type": "string",
              "minLength": 1,
              "description": "Category name; must already exist for this user with the given type."
            },
            "date": {
              "description": "Transaction date in YYYY-MM-DD. Defaults to today.",
              "type": "string"
            },
            "note": {
              "description": "Optional short note.",
              "type": "string"
            }
          },
          "required": [
            "amount",
            "type",
            "category_name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_transaction",
        "title": "Update transaction",
        "description": "Edit an existing transaction owned by the signed-in user. Any subset of fields can be updated. When category_name is provided, it is resolved case-insensitively against the user's categories of the transaction's (updated) type.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Transaction ID to update."
            },
            "amount": {
              "description": "New amount in the user's currency.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "type": {
              "description": "Change the transaction type; will also re-resolve the category if provided.",
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            },
            "category_name": {
              "description": "New category name; must exist for the user with the effective type.",
              "type": "string",
              "minLength": 1
            },
            "date": {
              "description": "New transaction date in YYYY-MM-DD.",
              "type": "string"
            },
            "note": {
              "description": "New note; pass null to clear.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_transaction",
        "title": "Delete transaction",
        "description": "Permanently delete a transaction owned by the signed-in user. Useful for removing duplicates or mistaken entries. Writes are scoped by Supabase RLS.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Transaction ID to delete."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "monthly_summary",
        "title": "Monthly summary",
        "description": "Summarize income, expenses, balance, and per-category expense totals for a given month for the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "month": {
              "description": "Month in YYYY-MM. Defaults to the current month.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "spending_summary",
        "title": "Spending summary",
        "description": "Aggregate the signed-in user's income and expense totals across one or more months, with per-category breakdowns and per-month series. Suitable for dashboard widgets and textual agent responses. Defaults to the current month when no range is given.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "month": {
              "description": "Single month in YYYY-MM. Ignored when start_month/end_month are set.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "start_month": {
              "description": "Inclusive start month in YYYY-MM for a multi-month range.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "end_month": {
              "description": "Inclusive end month in YYYY-MM for a multi-month range.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "top_categories": {
              "description": "Limit the category breakdown to the top N expense categories. Defaults to 10.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 50
            },
            "format": {
              "description": "'json' returns machine-readable structured content only; 'text' also includes a human-readable narrative. Defaults to 'text'.",
              "type": "string",
              "enum": [
                "json",
                "text"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_budgets",
        "title": "List budgets",
        "description": "List the signed-in user's category budgets for a given month, with amount spent, remaining, and percent used.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "month": {
              "description": "Month in YYYY-MM. Defaults to the current month.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "upsert_budget",
        "title": "Create or update budget",
        "description": "Create a new monthly budget or update the existing one for a category and month for the signed-in user. Resolves the category by name (case-insensitive) among the user's expense categories. Writes are scoped by Supabase RLS.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category_name": {
              "type": "string",
              "minLength": 1,
              "description": "Expense category name; must already exist for this user."
            },
            "month": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Budget month in YYYY-MM."
            },
            "limit_amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Spending limit for the month in the user's currency. Must be greater than 0."
            }
          },
          "required": [
            "category_name",
            "month",
            "limit_amount"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List the signed-in user's income and expense categories.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "type": {
              "description": "Filter by category type.",
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
