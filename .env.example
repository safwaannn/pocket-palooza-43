# Supabase — get these from your project's API settings
# https://supabase.com/dashboard/project/<your-project>/settings/api

# Used by Vite (client-side build)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Used by the server (SSR / serverFn)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Service role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Google Generative AI (Gemini) - get your key from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# Email budget alerts — Resend (https://resend.com). Both must be set for delivery.
# Leave blank in dev to make /api/email-budget-alerts a no-op.
RESEND_API_KEY=
PAISA_ALERTS_FROM=Paisa Alerts <alerts@example.com>

# Bearer token that must be presented to POST /api/email-budget-alerts. Empty = no auth check.
CRON_SECRET=
