# Supabase — get these from your project's API settings
# https://supabase.com/dashboard/project/<your-project>/settings/api

# Used by Vite (client-side build)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Used by the server (SSR / serverFn)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Service role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
